# ---- Server ----
PORT=5000
# Set to "production" on Render. Disables the automatic trust of localhost origins in CORS.
NODE_ENV=development

# ---- Google Gemini ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# text-embedding-004 has been retired; gemini-embedding-001 is the supported embedding model.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- CORS ----
# Comma-separated exact origins (scheme + host, no path or trailing slash).
# Localhost origins are allowed automatically when NODE_ENV is not "production".
# Production (GitHub Pages): https://aencruz.github.io
CLIENT_ORIGIN=http://localhost:8000,http://127.0.0.1:8000

# ---- Authentication (Supabase) ----
# The backend verifies the user's login token with Supabase. The PUBLIC anon key is enough for this
# (the same one used in frontend/js/supabase-config.js), so no secret is required.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional fallback if SUPABASE_ANON_KEY is not set (keep this secret, never commit it):
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# REQUIRE_AUTH=true  -> every AI request needs a valid login token (401 otherwise, 503 if Supabase is not
#                       configured). REQUIRED in production.
# REQUIRE_AUTH unset -> local development only: requests without a token continue as a "guest".
REQUIRE_AUTH=false

# ---- Medication push reminders (Web Push / VAPID) ----
# Generate your own pair once:  npx web-push generate-vapid-keys
# The PRIVATE key is a secret: set it in Render's Environment tab, never commit it.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com

# Where subscriptions are stored. REQUIRED in production (Render's disk is wiped on every restart):
#   1. Run backend/sql/push_subscriptions.sql in the Supabase SQL editor.
#   2. Set SUPABASE_SERVICE_ROLE_KEY (Supabase -> Project Settings -> API -> service_role). Keep it secret.
# Without it, a local file (backend/data/push-subscriptions.json) is used: fine for local testing only.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Secret for the external trigger POST /api/notifications/run-due (header "x-cron-secret").
# Point a free scheduler such as cron-job.org at it every minute so reminders still go out after
# Render's free plan puts the server to sleep. Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=your_random_secret_here
# Set to "false" to rely only on the external trigger.
# PUSH_INTERNAL_CRON=true
